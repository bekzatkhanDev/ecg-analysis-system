# Copy this file to .env and fill in the values before running docker-compose.

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# JWT expiry in minutes (default 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Server port ──────────────────────────────────────────────────────────────
# Port exposed on the host machine for the frontend (default 80)
HOST_PORT=80
